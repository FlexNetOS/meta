# Yazelix-owned RTK config input (reviewed repo copy).
#
# Ownership (YZXCONV-002 ratified-by-default convention, pending
# OWNERSHIP_MATRIX.md reconciliation):
#   editable input:   ~/.config/yazelix/rtk/config.toml.src
#   reviewed copy:    packaging/rtk/config.toml.src  (this file)
#   generated output: ~/.config/rtk/config.toml — written ONLY by
#                     nushell/scripts/materialize_rtk_config.nu at the
#                     approved cutover; never hand-edited.
#
# [shell] mode = "nu_shell" selects RTK's documented native Nushell
# integration: commands route through the profile rtk binary via
# nushell/config/rtk_wrappers.nu, and `rtk init` emits no legacy bash/zsh
# rewrite hooks (Claude settings.json PreToolUse, Cursor hooks.json,
# Gemini bash hook script).
#
# Note: rtk itself may append `[telemetry] consent_*` fields at runtime;
# the materializer archives any pre-existing output before overwriting,
# so runtime-written state is never destroyed.

[shell]
mode = "nu_shell"

[tracking]
enabled = true
history_days = 90

[display]
colors = true
emoji = true
max_width = 120

[filters]
ignore_dirs = [
    ".git",
    "node_modules",
    "target",
    "__pycache__",
    ".venv",
    "vendor",
]
ignore_files = [
    "*.lock",
    "*.min.js",
    "*.min.css",
]

[tee]
enabled = true
mode = "failures"
max_files = 20
max_file_size = 1048576

[telemetry]
enabled = false
consent_given = false
consent_date = "2026-07-10T16:16:20.047030796+00:00"

[hooks]
exclude_commands = [
    "^envctl",
    "^fxrun",
    "^cargo (test|build|check|clippy|nextest)",
    "^nix (build|flake check|develop|log)",
    "^gh (run view|run download|pr checks)",
    "^journalctl",
    "^dmesg",
    "^systemctl status",
    "^yzx (doctor|inspect)",
]
transparent_prefixes = [
    "timeout",
    "env -u RTK_SKIP_CHECKSUM",
]

[limits]
grep_max_results = 200
grep_max_per_file = 25
status_max_files = 15
status_max_untracked = 10
passthrough_max_chars = 2000
